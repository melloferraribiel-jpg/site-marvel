{title:'Doutor Estranho',type:'Filme',year:2016,order:2016.2,mark:'◎',tint:'#277078',desc:'Um cirurgião descobre um mundo de artes místicas e dimensões.'},
{title:'Vingadores: Ultimato',type:'Filme',year:2019,order:2023,mark:'A',tint:'#545458',desc:'Os Vingadores encaram as consequências de uma batalha decisiva.'},
