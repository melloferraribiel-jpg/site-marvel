{title:'Capitã Marvel',type:'Filme',year:2019,order:1995,mark:'✧',tint:'#394d9a',desc:'Uma aventura cósmica que se passa nos anos 1990.'},
{title:'Homem de Ferro',type:'Filme',year:2008,order:2008,mark:'✦',tint:'#9b3e2c',desc:'A tecnologia de Tony Stark dá início a uma nova era de heróis.'},
{title:'Os Vingadores',type:'Filme',year:2012,order:2012,mark:'A',tint:'#3c4f79',desc:'Heróis se unem diante de uma ameaça que nenhum deles pode enfrentar sozinho.'},
{title:'Guardiões da Galáxia',type:'Filme',year:2014,order:2014,mark:'☄',tint:'#8a5935',desc:'Uma equipe improvável encontra aventura e propósito entre as estrelas.'},
