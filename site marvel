const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const favorites=new Set(JSON.parse(localStorage.getItem('multiverso-favs')||'[]'));
function renderHeroes(){const q=document.getElementById('heroSearch').value.trim().toLocaleLowerCase('pt-BR'),team=document.getElementById('teamFilter').value,onlyFav=document.getElementById('showFav').dataset.active==='true';const list=heroes.filter(h=>(team==='all'||h.team===team)&&(!onlyFav||favorites.has(h.id))&&`${h.name} ${h.team} ${h.tag}`.toLocaleLowerCase('pt-BR').includes(q));const grid=document.getElementById('heroGrid');grid.innerHTML=list.length?list.map(h=>`<article class="card"><div class="portrait" style="--glow:${h.glow}" aria-hidden="true"><span class="sigil">${h.symbol}</span></div><div class="card-body"><div class="meta">${esc(h.tag)}</div><h3>${esc(h.name)}</h3><p>${esc(h.desc)}</p><div class="card-bottom"><button class="text-button details" data-id="${h.id}">Conhecer herói ↗</button><button class="fav ${favorites.has(h.id)?'active':''}" data-fav="${h.id}" aria-label="${favorites.has(h.id)?'Remover':'Adicionar'} ${esc(h.name)} ${favorites.has(h.id)?'dos':'aos'} favoritos" aria-pressed="${favorites.has(h.id)}">${favorites.has(h.id)?'♥':'♡'}</button></div></div></article>`).join(''):'<div class="empty">Nenhum herói encontrado. Tente outra busca ou filtro.</div>'}
function renderMedia(){const type=document.getElementById('mediaFilter').value,list=media.filter(m=>type==='all'||m.type===type);document.getElementById('mediaGrid').innerHTML=list.map(m=>`<article class="card movie-card"><div class="poster" style="--tint:${m.tint}" aria-hidden="true">${m.mark}</div><div class="movie-info"><div class="meta">${m.type} • ${m.year}</div><h3>${esc(m.title)}</h3><p>${esc(m.desc)}</p></div></article>`).join('')||'<div class="empty">Nenhum título nessa categoria.</div>'}
function renderTimeline(){const mode=document.getElementById('orderFilter').value,list=[...media].sort((a,b)=>mode==='release'?a.year-b.year:a.order-b.order);document.getElementById('timeline').innerHTML=list.map(m=>`<article class="tl-item"><div class="tl-row"><span class="tl-year">${mode==='release'?m.year:(m.order%1?Math.floor(m.order)+'*':m.order)}</span><span class="tl-title">${esc(m.title)}</span><span class="tl-type">${m.type}</span></div><p class="tl-desc">${esc(m.desc)}</p></article>`).join('')}
document.addEventListener('click',e=>{const fav=e.target.closest('[data-fav]');if(fav){const id=fav.dataset.fav;favorites.has(id)?favorites.delete(id):favorites.add(id);localStorage.setItem('multiverso-favs',JSON.stringify([...favorites]));renderHeroes();return}const details=e.target.closest('.details');if(details){const h=heroes.find(x=>x.id===details.dataset.id);document.getElementById('modalContent').innerHTML=`<div class="portrait" style="--glow:${h.glow}" aria-hidden="true"><span class="sigil">${h.symbol}</span></div><div class="meta">${esc(h.team)} • ${esc(h.tag)}</div><h2 id="modalTitle">${esc(h.name)}</h2><p>${esc(h.detail)}</p>`;document.getElementById('heroModal').classList.add('open');document.getElementById('closeModal').focus();return}if(e.target.classList.contains('quiz-answer')){document.getElementById('quizResult').textContent=e.target.dataset.correct==='true'?'Isso! Thor é o Deus do Trovão. ⚡':'Quase! A resposta é Thor. ⚡'}if(e.target.id==='closeModal'||e.target.id==='heroModal')document.getElementById('heroModal').classList.remove('open')});
document.getElementById('heroSearch').addEventListener('input',renderHeroes);document.getElementById('teamFilter').addEventListener('change',renderHeroes);document.getElementById('mediaFilter').addEventListener('change',renderMedia);document.getElementById('orderFilter').addEventListener('change',renderTimeline);document.getElementById('showFav').addEventListener('click',e=>{const b=e.currentTarget,active=b.dataset.active==='true';b.dataset.active=String(!active);b.setAttribute('aria-label',active?'Mostrar todos os heróis':'Mostrar apenas favoritos');b.title=active?'Mostrar todos os heróis':'Mostrar apenas favoritos';renderHeroes()});document.getElementById('menuBtn').addEventListener('click',e=>{const n=document.getElementById('nav'),open=n.classList.toggle('open');e.currentTarget.setAttribute('aria-expanded',String(open))});document.querySelectorAll('#nav a').forEach(a=>a.addEventListener('click',()=>{document.getElementById('nav').classList.remove('open');document.getElementById('menuBtn').setAttribute('aria-expanded','false')}));document.getElementById('closeModal').addEventListener('click',()=>document.getElementById('heroModal').classList.remove('open'));document.addEventListener('keydown',e=>{if(e.key==='Escape')document.getElementById('heroModal').classList.remove('open')});window.addEventListener('scroll',()=>document.getElementById('toTop').classList.toggle('show',scrollY>500));document.getElementById('toTop').addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));renderHeroes();renderMedia();renderTimeline();
</script></body></html>

